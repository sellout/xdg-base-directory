source-repository-package
  type: git
  location: https://github.com/sellout/pathway.git
  branch: system-directories
  subdir:
    internal
    pathway
    system

flags:
  -noisy-deprecations

program-options
  ghc-options:
    -Werror

tests: True

packages:
  ./core/xdg-base-directory.cabal
  ./internal/xdg-base-directory-internal.cabal
